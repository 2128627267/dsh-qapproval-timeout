{
  "name": "dsh-approval-timeout",
  "version": "2.0.0",
  "description": "Approval timeout for DeepSeek Harness: when a sandbox/escalation approval is not answered within a configurable period, the request is automatically rejected instead of waiting forever.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "license": "MIT",
  "author": "qf",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "approval",
    "timeout",
    "sandbox",
    "qf"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/2128627267/dsh-qaptm.git"
  },
  "homepage": "https://github.com/2128627267/dsh-qaptm#readme",
  "bugs": {
    "url": "https://github.com/2128627267/dsh-qaptm/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
