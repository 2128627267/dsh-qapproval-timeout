{
  "name": "dsh-approval-timeout",
  "version": "1.1.1",
  "description": "Approval timeout for DeepSeek Harness: when a sandbox/escalation approval is not answered within a configurable period, the request is automatically rejected instead of waiting forever.",
  "main": "index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "dynamic": {
      "idPrefix": "qaptm",
      "purpose": "Approval timeout for DeepSeek Harness: when a sandbox/escalation approval is not answered within a configurable period, the request is automatically rejected instead of waiting forever.",
      "host": "host.js",
      "client": "client.js"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "license": "MIT",
  "author": "qf",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "approval",
    "timeout",
    "sandbox",
    "qf"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/2128627267/dsh-qaptm.git"
  },
  "homepage": "https://github.com/2128627267/dsh-qaptm#readme",
  "bugs": {
    "url": "https://github.com/2128627267/dsh-qaptm/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "host.js",
    "client.js",
    "client-loader.js",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client-loader.js"
  }
}
